{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc-glibc",
      "displayName": "GCC 16 / glibc (host dependencies)",
      "description": "GCC 16 reflection compiler with existing ABI-matched grpcxx dependencies.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-glibc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "$env{HOME}/.local/toolchain/gcc-glibc/bin/x86_64-unknown-linux-gnu-g++",
        "CMAKE_PREFIX_PATH": "$env{HOME}/.local/grpcxx-deps/gcc-glibc;/usr",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--sysroot=/ -L/usr/lib/x86_64-linux-gnu -Wl,-rpath-link,/usr/lib/x86_64-linux-gnu -Wl,--dynamic-linker=/lib64/ld-linux-x86-64.so.2",
        "CMAKE_SYSROOT": "/",
        "CMAKE_CXX_FLAGS": "-B/usr/lib/x86_64-linux-gnu -idirafter /usr/include/x86_64-linux-gnu -std=c++26 -freflection -fno-exceptions",
        "GREPTIMEDB_BUILD_TESTING": "ON",
        "GREPTIMEDB_BUILD_BENCHMARKS": "OFF",
        "BENCHMARK_ENABLE_WERROR": "OFF",
        "GRPCXX_SOURCE_DIR": "${sourceDir}/../grpcxx"
      },
      "environment": {
        "PKG_CONFIG_PATH": "$env{HOME}/.local/grpcxx-deps/gcc-glibc/lib/pkgconfig:$penv{PKG_CONFIG_PATH}"
      }
    },
    {
      "name": "gcc-glibc-vcpkg",
      "displayName": "GCC 16 / glibc (vcpkg manifest)",
      "description": "GCC 16 reflection compiler with manifest dependencies and host grpcxx code-generator prerequisites.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc-glibc-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "$env{HOME}/.local/toolchain/gcc-glibc/bin/x86_64-unknown-linux-gnu-g++",
        "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/gcc-glibc-vcpkg/vcpkg_installed",
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GREPTIMEDB_BUILD_TESTING": "ON",
        "GREPTIMEDB_BUILD_BENCHMARKS": "OFF",
        "BENCHMARK_ENABLE_WERROR": "OFF",
        "GRPCXX_SOURCE_DIR": "${sourceDir}/../grpcxx",
        "CMAKE_PREFIX_PATH": "$env{HOME}/.local/grpcxx-deps/gcc-glibc;/usr",
        "CMAKE_SYSROOT": "/",
        "CMAKE_CXX_FLAGS": "-B/usr/lib/x86_64-linux-gnu -idirafter /usr/include/x86_64-linux-gnu -std=c++26 -freflection -fno-exceptions",
        "CMAKE_EXE_LINKER_FLAGS": "-Wl,--sysroot=/ -L/usr/lib/x86_64-linux-gnu -Wl,-rpath-link,/usr/lib/x86_64-linux-gnu -Wl,--dynamic-linker=/lib64/ld-linux-x86-64.so.2"
      }
    },
    {
      "name": "clang-glibc",
      "displayName": "Clang 21 P2996 / glibc",
      "description": "Requires a Clang P2996 reflection compiler and ABI-matched dependencies.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang-glibc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "$env{HOME}/.local/toolchain/clang-glibc/bin/clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GREPTIMEDB_BUILD_TESTING": "ON",
        "GREPTIMEDB_BUILD_BENCHMARKS": "OFF",
        "BENCHMARK_ENABLE_WERROR": "OFF",
        "GRPCXX_SOURCE_DIR": "${sourceDir}/../grpcxx",
        "CMAKE_PREFIX_PATH": "$env{HOME}/.local/grpcxx-deps/gcc-glibc;/usr",
        "CMAKE_CXX_FLAGS": "-std=c++26 -freflection-latest -fno-exceptions"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-glibc",
      "configurePreset": "gcc-glibc",
      "jobs": 8
    },
    {
      "name": "gcc-glibc-vcpkg",
      "configurePreset": "gcc-glibc-vcpkg",
      "jobs": 8
    },
    {
      "name": "clang-glibc",
      "configurePreset": "clang-glibc",
      "jobs": 8
    }
  ]
}
