{
  "name": "greptimedb",
  "version-semver": "@VERSION@",
  "description": "C++26 GreptimeDB SDK with columnar ingestion, reflected rows, SQL and Arrow Flight streaming",
  "homepage": "https://github.com/trunkszi/greptimedb",
  "license": "MIT",
  "supports": "linux & x64",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    },
    {
      "name": "grpcxx",
      "host": true
    },
    {
      "name": "protobuf",
      "host": true
    },
    "cares",
    "grpcxx",
    "lz4",
    "nexora",
    "protobuf",
    "uarch",
    "uring",
    "zstd"
  ]
}
