include_guard(GLOBAL)

function(greptimedb_find_host_tool output relative)
  set(installed "${_VCPKG_INSTALLED_DIR}")
  if(NOT installed)
    set(installed "${VCPKG_INSTALLED_DIR}")
  endif()
  set(candidate "${installed}/${VCPKG_HOST_TRIPLET}/${relative}")
  if(installed AND VCPKG_HOST_TRIPLET AND EXISTS "${candidate}")
    set(${output} "${candidate}" PARENT_SCOPE)
  else()
    set(${output} "" PARENT_SCOPE)
  endif()
endfunction()
