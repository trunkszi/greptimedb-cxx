include_guard(GLOBAL)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(DEFINED ENV{TOOLCHAIN_ROOT} AND NOT "$ENV{TOOLCHAIN_ROOT}" STREQUAL "")
  set(_tc_root "$ENV{TOOLCHAIN_ROOT}/clang-musl")
else()
  set(_tc_root "$ENV{HOME}/.local/toolchain/clang-musl")
endif()
set(_sysroot "${_tc_root}/x86_64-unknown-linux-musl/sysroot")
set(CMAKE_C_COMPILER "${_tc_root}/bin/x86_64-unknown-linux-musl-clang")
set(CMAKE_CXX_COMPILER "${_tc_root}/bin/x86_64-unknown-linux-musl-clang++")
set(CMAKE_SYSROOT "${_sysroot}")
set(CMAKE_C_COMPILER_LAUNCHER ccache CACHE STRING "")
set(CMAKE_CXX_COMPILER_LAUNCHER ccache CACHE STRING "")
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
string(APPEND CMAKE_CXX_FLAGS_INIT " -stdlib=libc++")
set(_ld_flags "-B${_tc_root}/bin -fuse-ld=lld -Wl,-z,stack-size=8388608 -Wl,--dynamic-linker,${_sysroot}/lib/ld-musl-x86_64.so.1 --rtlib=compiler-rt --unwindlib=libunwind -Wl,-rpath,${_sysroot}/usr/lib -Wl,-rpath,${_sysroot}/lib")
string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " ${_ld_flags}")
string(APPEND CMAKE_SHARED_LINKER_FLAGS_INIT " -B${_tc_root}/bin -fuse-ld=lld --rtlib=compiler-rt --unwindlib=libunwind")
set(CMAKE_FIND_ROOT_PATH "${_sysroot}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
include("${CMAKE_CURRENT_LIST_DIR}/vcpkg-flags.cmake")
