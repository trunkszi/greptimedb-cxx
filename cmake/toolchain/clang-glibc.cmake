include_guard(GLOBAL)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(DEFINED ENV{TOOLCHAIN_ROOT} AND NOT "$ENV{TOOLCHAIN_ROOT}" STREQUAL "")
  set(_tc_root "$ENV{TOOLCHAIN_ROOT}/clang-glibc")
else()
  set(_tc_root "$ENV{HOME}/.local/toolchain/clang-glibc")
endif()
set(_sysroot "${_tc_root}/x86_64-unknown-linux-gnu/sysroot")
if(EXISTS "${_tc_root}/bin/clang++" AND NOT EXISTS "${_tc_root}/bin/clang++.cfg")
  file(WRITE "${_tc_root}/bin/clang++.cfg"
"--sysroot=<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot\n--gcc-toolchain=<CFGDIR>/..\n-stdlib=libc++\n-Wl,-rpath,<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot/usr/lib\n-Wl,-rpath,<CFGDIR>/../lib/x86_64-unknown-linux-gnu\n")
endif()
if(EXISTS "${_tc_root}/bin/clang" AND NOT EXISTS "${_tc_root}/bin/clang.cfg")
  file(WRITE "${_tc_root}/bin/clang.cfg"
"--sysroot=<CFGDIR>/../x86_64-unknown-linux-gnu/sysroot\n--gcc-toolchain=<CFGDIR>/..\n")
endif()
set(CMAKE_C_COMPILER "${_tc_root}/bin/clang")
set(CMAKE_CXX_COMPILER "${_tc_root}/bin/clang++")
set(CMAKE_SYSROOT "${_sysroot}")
set(CMAKE_C_COMPILER_LAUNCHER ccache CACHE STRING "")
set(CMAKE_CXX_COMPILER_LAUNCHER ccache CACHE STRING "")
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(_inc_flags "-B/usr/lib/x86_64-linux-gnu -idirafter /usr/include/x86_64-linux-gnu -idirafter /usr/include")
string(APPEND CMAKE_C_FLAGS_INIT " ${_inc_flags}")
string(APPEND CMAKE_CXX_FLAGS_INIT " -stdlib=libc++ ${_inc_flags}")
set(_ld_flags "-B${_tc_root}/bin -fuse-ld=lld -Wl,--sysroot=/ -L/usr/lib/x86_64-linux-gnu -Wl,-rpath-link,/usr/lib/x86_64-linux-gnu -Wl,--dynamic-linker=/lib64/ld-linux-x86-64.so.2 --rtlib=compiler-rt --unwindlib=libunwind -Wl,-rpath,${_sysroot}/usr/lib -Wl,-rpath,${_tc_root}/lib/x86_64-unknown-linux-gnu")
string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " ${_ld_flags}")
string(APPEND CMAKE_SHARED_LINKER_FLAGS_INIT " -B${_tc_root}/bin -fuse-ld=lld -L/usr/lib/x86_64-linux-gnu --rtlib=compiler-rt --unwindlib=libunwind")
include("${CMAKE_CURRENT_LIST_DIR}/vcpkg-flags.cmake")
