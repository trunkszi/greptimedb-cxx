include_guard(GLOBAL)
foreach(_lang IN ITEMS C CXX)
  foreach(_sfx IN ITEMS "" "_DEBUG" "_RELEASE")
    set(_var "VCPKG_${_lang}_FLAGS${_sfx}")
    if(DEFINED ${_var} AND NOT "${${_var}}" STREQUAL "")
      string(APPEND CMAKE_${_lang}_FLAGS${_sfx}_INIT " ${${_var}}")
    endif()
    list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES "${_var}")
  endforeach()
endforeach()
foreach(_sfx IN ITEMS "" "_DEBUG" "_RELEASE")
  set(_var "VCPKG_LINKER_FLAGS${_sfx}")
  if(DEFINED ${_var} AND NOT "${${_var}}" STREQUAL "")
    foreach(_kind IN ITEMS EXE SHARED MODULE)
      string(APPEND CMAKE_${_kind}_LINKER_FLAGS${_sfx}_INIT " ${${_var}}")
    endforeach()
  endif()
  list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES "${_var}")
endforeach()
