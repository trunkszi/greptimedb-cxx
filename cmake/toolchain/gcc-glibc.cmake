include_guard(GLOBAL)
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(DEFINED ENV{TOOLCHAIN_ROOT} AND NOT "$ENV{TOOLCHAIN_ROOT}" STREQUAL "")
  set(_tc_root "$ENV{TOOLCHAIN_ROOT}/gcc-glibc")
else()
  set(_tc_root "$ENV{HOME}/.local/toolchain/gcc-glibc")
endif()
set(CMAKE_C_COMPILER "${_tc_root}/bin/x86_64-unknown-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${_tc_root}/bin/x86_64-unknown-linux-gnu-g++")
set(CMAKE_SYSROOT "/")
set(CMAKE_C_COMPILER_LAUNCHER ccache CACHE STRING "")
set(CMAKE_CXX_COMPILER_LAUNCHER ccache CACHE STRING "")
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(_inc_flags "-B/usr/lib/x86_64-linux-gnu -idirafter /usr/include/x86_64-linux-gnu -idirafter /usr/include")
string(APPEND CMAKE_C_FLAGS_INIT " ${_inc_flags}")
string(APPEND CMAKE_CXX_FLAGS_INIT " ${_inc_flags}")
find_program(_gcc_glibc_mold NAMES mold)
set(_mold_flag "")
if(_gcc_glibc_mold)
  set(_mold_flag "-fuse-ld=mold ")
endif()
set(_ld_flags "${_mold_flag}-Wl,--sysroot=/ -L/usr/lib/x86_64-linux-gnu -Wl,-rpath-link,/usr/lib/x86_64-linux-gnu -Wl,--dynamic-linker=/lib64/ld-linux-x86-64.so.2 -Wl,-rpath,${_tc_root}/x86_64-unknown-linux-gnu/lib64")
string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " ${_ld_flags}")
string(APPEND CMAKE_SHARED_LINKER_FLAGS_INIT " ${_mold_flag}-L/usr/lib/x86_64-linux-gnu")
include("${CMAKE_CURRENT_LIST_DIR}/vcpkg-flags.cmake")
