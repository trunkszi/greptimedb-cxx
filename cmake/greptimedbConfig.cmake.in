@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
set(protobuf_MODULE_COMPATIBLE ON)
find_package(Protobuf CONFIG QUIET)
if(NOT Protobuf_FOUND)
  find_dependency(Protobuf)
endif()
find_dependency(uarch CONFIG)
find_dependency(cares CONFIG)
find_dependency(nexora CONFIG)
find_dependency(grpcxx CONFIG)
find_package(FlatBuffers CONFIG QUIET)
include("${CMAKE_CURRENT_LIST_DIR}/GreptimeCompressionDependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/greptimedb-targets.cmake")
check_required_components(greptimedb)
