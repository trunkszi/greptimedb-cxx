include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/GreptimeHostTools.cmake")

set(GREPTIME_PROTO_REVISION "acb247415b8f4c2f0750783dab4e1f38c71f5860")
set(GREPTIME_PROTO_DIR "" CACHE PATH "Pinned greptime-proto checkout or its proto directory")
set(GREPTIME_PROTO_VERIFIED_REVISION "" CACHE STRING "Pinned revision attested by a source archive fetcher")
if(NOT DEFINED GREPTIME_PROTO_GIT_REPOSITORY OR "${GREPTIME_PROTO_GIT_REPOSITORY}" STREQUAL "")
  set(GREPTIME_PROTO_GIT_REPOSITORY "https://github.com/GreptimeTeam/greptime-proto.git")
endif()

function(greptimedb_assert_safe_to_manage source is_default_cache)
  if(NOT EXISTS "${source}" OR is_default_cache OR EXISTS "${source}/.git/greptimedb-proto-managed")
    return()
  endif()
  if(IS_DIRECTORY "${source}")
    file(GLOB dir_entries LIST_DIRECTORIES true "${source}/*" "${source}/.*")
    list(FILTER dir_entries EXCLUDE REGEX "/\\.?\\.$")
    if(dir_entries STREQUAL "")
      return()
    endif()
  endif()
  message(FATAL_ERROR
    "GREPTIME_PROTO_DIR=${source} must contain proto/greptime/v1 or greptime/v1; "
    "refusing to overwrite non-empty unmanaged directory")
endfunction()

function(greptimedb_clone_proto source is_default_cache)
  if(EXISTS "${source}/.git"
      AND (IS_DIRECTORY "${source}/proto/greptime/v1" OR IS_DIRECTORY "${source}/greptime/v1"))
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" rev-parse HEAD
      RESULT_VARIABLE head_res OUTPUT_VARIABLE actual_head OUTPUT_STRIP_TRAILING_WHITESPACE
      ERROR_QUIET)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0
      "${GIT_EXECUTABLE}" -C "${source}" status --porcelain -- .
      RESULT_VARIABLE status_res OUTPUT_VARIABLE status_out ERROR_QUIET)
    if(head_res EQUAL 0 AND actual_head STREQUAL GREPTIME_PROTO_REVISION
        AND status_res EQUAL 0 AND status_out STREQUAL "")
      return()
    endif()
  endif()
  greptimedb_assert_safe_to_manage("${source}" "${is_default_cache}")
  if(EXISTS "${source}")
    file(REMOVE_RECURSE "${source}")
  endif()
  file(MAKE_DIRECTORY "${source}")
  if(NOT EXISTS "${source}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" init "${source}"
      RESULT_VARIABLE init_res ERROR_VARIABLE details)
    if(NOT init_res EQUAL 0)
      file(REMOVE_RECURSE "${source}")
      message(FATAL_ERROR "Cannot initialize pinned greptime-proto ${source}: ${details}")
    endif()
  endif()
  file(WRITE "${source}/.git/greptimedb-proto-managed" "${GREPTIME_PROTO_REVISION}\n")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" fetch --depth 1
    "${GREPTIME_PROTO_GIT_REPOSITORY}" "${GREPTIME_PROTO_REVISION}"
    RESULT_VARIABLE fetch_res ERROR_VARIABLE details)
  if(NOT fetch_res EQUAL 0)
    file(REMOVE_RECURSE "${source}")
    message(FATAL_ERROR "Cannot fetch pinned greptime-proto ${source}: ${details}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" checkout --detach FETCH_HEAD
    RESULT_VARIABLE checkout_res ERROR_VARIABLE details)
  if(NOT checkout_res EQUAL 0)
    file(REMOVE_RECURSE "${source}")
    message(FATAL_ERROR "Cannot checkout pinned greptime-proto ${source}: ${details}")
  endif()
endfunction()

function(greptimedb_resolve_proto_root output)
  set(is_default_cache FALSE)
  if(GREPTIME_PROTO_DIR)
    set(source "${GREPTIME_PROTO_DIR}")
  elseif(DEFINED ENV{GREPTIME_PROTO_DIR} AND NOT "$ENV{GREPTIME_PROTO_DIR}" STREQUAL "")
    set(source "$ENV{GREPTIME_PROTO_DIR}")
  elseif(DEFINED ENV{HOME} AND NOT "$ENV{HOME}" STREQUAL "")
    set(source "$ENV{HOME}/.cache/greptime-proto")
    set(is_default_cache TRUE)
  else()
    message(FATAL_ERROR "Set GREPTIME_PROTO_DIR: HOME is unset and no protocol source was supplied")
  endif()
  get_filename_component(source "${source}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
  if(NOT "${GREPTIME_PROTO_VERIFIED_REVISION}" STREQUAL "")
    if(NOT "${GREPTIME_PROTO_VERIFIED_REVISION}" STREQUAL "${GREPTIME_PROTO_REVISION}")
      message(FATAL_ERROR
        "GREPTIME_PROTO_VERIFIED_REVISION must match pinned revision ${GREPTIME_PROTO_REVISION}; "
        "found '${GREPTIME_PROTO_VERIFIED_REVISION}'")
    endif()
    if(EXISTS "${source}/proto/greptime/v1/database.proto")
      set(root "${source}/proto")
    elseif(EXISTS "${source}/greptime/v1/database.proto")
      set(root "${source}")
    else()
      message(FATAL_ERROR
        "Verified greptime-proto archive ${source} must contain proto/greptime/v1/database.proto "
        "or greptime/v1/database.proto")
    endif()
    set(${output} "${root}" PARENT_SCOPE)
    return()
  endif()
  find_package(Git REQUIRED)
  if(NOT IS_DIRECTORY "${source}/proto/greptime/v1" AND NOT IS_DIRECTORY "${source}/greptime/v1")
    greptimedb_assert_safe_to_manage("${source}" "${is_default_cache}")
  endif()
  if(is_default_cache OR EXISTS "${source}/.git/greptimedb-proto-managed"
      OR (NOT IS_DIRECTORY "${source}/proto/greptime/v1" AND NOT IS_DIRECTORY "${source}/greptime/v1"))
    get_filename_component(parent "${source}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    file(LOCK "${source}.lock" GUARD FUNCTION TIMEOUT 120 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
      message(FATAL_ERROR "Cannot lock greptime-proto cache ${source}: ${lock_result}")
    endif()
    if(NOT IS_DIRECTORY "${source}/proto/greptime/v1" AND NOT IS_DIRECTORY "${source}/greptime/v1")
      greptimedb_clone_proto("${source}" "${is_default_cache}")
    endif()
  endif()
  if(IS_DIRECTORY "${source}/proto/greptime/v1")
    set(root "${source}/proto")
  elseif(IS_DIRECTORY "${source}/greptime/v1")
    set(root "${source}")
  else()
    message(FATAL_ERROR "GREPTIME_PROTO_DIR=${source} must contain proto/greptime/v1 or greptime/v1")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" rev-parse HEAD
    RESULT_VARIABLE result OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_VARIABLE details)
  if(NOT result EQUAL 0 OR NOT actual STREQUAL GREPTIME_PROTO_REVISION)
    message(FATAL_ERROR
      "greptime-proto ${source} must be a Git checkout at ${GREPTIME_PROTO_REVISION}; "
      "found '${actual}'. The supplied checkout has not been modified. ${details}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env GIT_OPTIONAL_LOCKS=0
    "${GIT_EXECUTABLE}" -C "${root}" status --porcelain -- .
    RESULT_VARIABLE result OUTPUT_VARIABLE changes ERROR_VARIABLE details)
  if(NOT result EQUAL 0 OR NOT changes STREQUAL "")
    message(FATAL_ERROR "greptime-proto sources must be clean at the pinned revision: ${changes}${details}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" symbolic-ref -q HEAD
    RESULT_VARIABLE symbolic_result OUTPUT_VARIABLE symbolic_ref OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(provenance HEAD index packed-refs)
  if(symbolic_result EQUAL 0)
    list(APPEND provenance "${symbolic_ref}")
  endif()
  foreach(entry IN LISTS provenance)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" rev-parse --git-path "${entry}"
      RESULT_VARIABLE result OUTPUT_VARIABLE path OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot resolve greptime-proto provenance ${entry}")
    endif()
    get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${root}")
    if(EXISTS "${path}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    endif()
  endforeach()
  set(${output} "${root}" PARENT_SCOPE)
endfunction()

function(greptimedb_generate_proto_library)
  foreach(required grpcxx::codec_protobuf grpcxx::reflection)
    if(NOT TARGET "${required}")
      message(FATAL_ERROR "Greptime protocol generation requires target ${required}")
    endif()
  endforeach()
  greptimedb_find_host_tool(host_plugin tools/grpcxx/protoc-gen-grpcxx)
  greptimedb_find_host_tool(host_protoc tools/protobuf/protoc)
  if(host_protoc)
    set(protoc_file "${host_protoc}")
    set(protoc_dependency "${host_protoc}")
  elseif(TARGET protobuf::protoc)
    set(protoc_file "$<TARGET_FILE:protobuf::protoc>")
    set(protoc_dependency protobuf::protoc)
  else()
    message(FATAL_ERROR "Protocol generation requires a host protoc executable")
  endif()
  if(host_plugin)
    set(plugin_target "${host_plugin}")
    set(plugin_file "${host_plugin}")
  elseif(TARGET protoc-gen-grpcxx)
    set(plugin_target protoc-gen-grpcxx)
    set(plugin_file "$<TARGET_FILE:protoc-gen-grpcxx>")
  elseif(TARGET grpcxx::protoc-gen-grpcxx)
    set(plugin_target grpcxx::protoc-gen-grpcxx)
    set(plugin_file "$<TARGET_FILE:grpcxx::protoc-gen-grpcxx>")
  else()
    find_program(_greptimedb_grpcxx_plugin NAMES protoc-gen-grpcxx REQUIRED)
    set(plugin_target "${_greptimedb_grpcxx_plugin}")
    set(plugin_file "${_greptimedb_grpcxx_plugin}")
  endif()
  greptimedb_resolve_proto_root(proto_root)
  set(local_root "${PROJECT_SOURCE_DIR}/proto")
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/generated")
  file(MAKE_DIRECTORY "${generated}")
  file(GLOB_RECURSE upstream CONFIGURE_DEPENDS
    "${proto_root}/greptime/v1/*.proto"
    "${proto_root}/substrait_extension/*.proto"
    "${proto_root}/prometheus/*.proto")
  if(NOT upstream)
    message(FATAL_ERROR "No Greptime protocol files found in ${proto_root}")
  endif()
  list(SORT upstream)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${upstream})
  set(inputs ${upstream} "${local_root}/Flight.proto")
  set(protobuf_includes)
  if(TARGET protobuf::libprotobuf)
    get_target_property(protobuf_includes protobuf::libprotobuf INTERFACE_INCLUDE_DIRECTORIES)
  endif()
  find_path(wellknown_include google/protobuf/timestamp.proto
    HINTS ${Protobuf_INCLUDE_DIRS} ${Protobuf_INCLUDE_DIR} ${protobuf_includes} NO_CACHE REQUIRED)
  set(include_arguments "--proto_path=${proto_root}" "--proto_path=${local_root}"
    "--proto_path=${wellknown_include}")
  set(sources)
  set(headers)
  foreach(input IN LISTS inputs)
    if(input STREQUAL "${local_root}/Flight.proto")
      set(relative "Flight.proto")
    else()
      file(RELATIVE_PATH relative "${proto_root}" "${input}")
    endif()
    string(REGEX REPLACE "\\.proto$" "" stem "${relative}")
    set(source "${generated}/${stem}.pb.cc")
    set(message_header "${generated}/${stem}.pb.h")
    set(contract_header "${generated}/${stem}.grpcxx.h")
    get_filename_component(directory "${source}" DIRECTORY)
    add_custom_command(OUTPUT "${source}" "${message_header}" "${contract_header}"
      COMMAND "${CMAKE_COMMAND}" -E make_directory "${directory}"
      COMMAND "${protoc_file}" ${include_arguments}
        "--cpp_out=${generated}"
        "--plugin=protoc-gen-grpcxx=${plugin_file}"
        "--grpcxx_out=${generated}" "${input}"
      DEPENDS ${inputs} "${wellknown_include}/google/protobuf/duration.proto"
        ${protoc_dependency} ${plugin_target}
      COMMENT "Generating Greptime messages and contracts: ${relative}"
      VERBATIM COMMAND_EXPAND_LISTS)
    list(APPEND sources "${source}")
    list(APPEND headers "${message_header}" "${contract_header}")
  endforeach()
  add_custom_target(greptimedb_proto_codegen DEPENDS ${sources} ${headers})
  add_library(greptimedb_proto STATIC ${sources} ${headers})
  add_library(greptimedb::proto ALIAS greptimedb_proto)
  add_dependencies(greptimedb_proto greptimedb_proto_codegen)
  target_include_directories(greptimedb_proto PUBLIC
    "$<BUILD_INTERFACE:${generated}>" "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/src>")
  target_link_libraries(greptimedb_proto PUBLIC grpcxx::codec_protobuf grpcxx::reflection)
  if(TARGET greptimedb_compile_options)
    target_link_libraries(greptimedb_proto PUBLIC greptimedb_compile_options)
  endif()
endfunction()
